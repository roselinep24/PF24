# _headers — En-têtes de sécurité HTTP pour Cloudflare Pages
# Documentation : https://developers.cloudflare.com/pages/configuration/headers/
# Déposez ce fichier à la racine de votre projet GitHub

/*
  # Forçage HTTPS avec HSTS (Strict Transport Security)
  # Durée : 1 an — includeSubDomains : oui — preload : oui
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Empêche le sniffing de type MIME (sécurité contre les attaques XSS)
  X-Content-Type-Options: nosniff

  # Empêche l'intégration du site dans une iframe (clickjacking)
  X-Frame-Options: SAMEORIGIN

  # Politique de référent : envoie uniquement l'origine, pas le chemin complet
  Referrer-Policy: strict-origin-when-cross-origin

  # Désactive les fonctionnalités navigateur non utilisées
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Content Security Policy (CSP)
  # Adapté au site PF24 QSE :
  # - Google Fonts pour la typographie
  # - Google Analytics 4 (commenté — décommentez si GA4 activé)
  # - unsafe-inline nécessaire car CSS et JS sont embarqués dans les HTML
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://hooks.zapier.com; frame-ancestors 'none';

# En-tête supplémentaire pour les pages légales uniquement
/mentions-legales.html
  X-Robots-Tag: noindex, follow

/politique-confidentialite.html
  X-Robots-Tag: noindex, follow
